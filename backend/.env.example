# Copy to .env for local runs. Render sets these as Environment Variables.

# --- LLM -------------------------------------------------------------------
# gemini | cerebras | mistral | openai. Leave empty to run the rules fallback,
# which still gives a usable next question on every stage.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Storage ---------------------------------------------------------------
# Both empty -> local SQLite at ./data/calls.db (zero setup, used for the demo).
SUPABASE_URL=
SUPABASE_KEY=

# --- CORS ------------------------------------------------------------------
# Comma separated. On Render set this to the Vercel URL, e.g.
# https://call-copilot.vercel.app
ALLOWED_ORIGINS=*
