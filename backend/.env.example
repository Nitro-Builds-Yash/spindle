# Copy to .env for local runs. Render sets these as Environment Variables.

# --- LLM -------------------------------------------------------------------
# gemini | cerebras | mistral | openai.
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-lite-latest
# Hard ceiling (seconds) for one AI answer; past it the rules fallback replies.
LLM_TIMEOUT_SECONDS=4

# --- Storage ---------------------------------------------------------------
# Both empty -> local SQLite at ./data/calls.db (zero setup, used for the demo).
SUPABASE_URL=
SUPABASE_KEY=

# --- CORS ------------------------------------------------------------------
# Comma separated. On Render set this to the Vercel URL, e.g.
# https://call-copilot.vercel.app
# Empty/unset -> only the local Vite dev server (localhost:5173 / 4173).
ALLOWED_ORIGINS=

# --- Access ----------------------------------------------------------------
# Shared token callers type into the app once. Unset -> API is open (local dev
# only). ALWAYS set this on Render: `python -c "import secrets;print(secrets.token_urlsafe(24))"`
SPINDLE_ACCESS_TOKEN=
