# Copy to .env.local for local development. On Vercel this is a Project
# Environment Variable.
#
# Local API (uvicorn on port 8000)
VITE_API_BASE=http://127.0.0.1:8000
#
# Deployed API
# VITE_API_BASE=https://<your-api>.onrender.com
#
# Optional: Sentry error tracking (create a free project at sentry.io)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
